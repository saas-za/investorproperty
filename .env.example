# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# --- Contact form --------------------------------------------------------
# The "Require more in-depth market research?" form on the Desktop Land
# Estimate sends through Resend. Without both of these the form still works
# and reports success, but logs the enquiry instead of sending it — so the
# page never fails in front of a prospect.
#
# Use the same Resend key as the portal. CONTACT_FROM_EMAIL must be on a
# domain verified in Resend; until investorproperty.co.za is verified there,
# onboarding@resend.dev works for testing and delivers only to your own
# Resend account address.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=estimate@investorproperty.co.za

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
